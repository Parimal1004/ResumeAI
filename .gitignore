@"
# Virtual environments
venv/
.venv/

# Environment variables / secrets
.env
.env.*
!.env.example

# Python cache
__pycache__/
*.py[cod]

# Pytest
.pytest_cache/

# Databases
*.db
*.sqlite
*.sqlite3

# IDE
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

# Temporary files
*.tmp
*.temp
"@ | Set-Content .gitignore